{
  "manifest_version": 3,
  "name": "Ad Muter",
  "description": "Mutes the tab and blurs the player during ad breaks; chimes when an ad turns skippable. Nothing is blocked or sent anywhere.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Muter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
