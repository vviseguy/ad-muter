{
  "manifest_version": 3,
  "name": "Ad Muter",
  "version": "0.2.0",
  "description": "Mutes the tab — and optionally blurs the player — while a supported web player is on an ad break. Nothing is blocked, intercepted, or sent anywhere.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Muter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
